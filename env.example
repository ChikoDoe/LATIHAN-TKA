# ── Pilih provider: anthropic atau openai ──────────────────────
API_PROVIDER=anthropic

# ── Anthropic ───────────────────────────────────────────────────
# API key — daftar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL (opsional) — ganti jika pakai proxy/OpenRouter/dll
# Default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model (opsional) — default: claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=anthropic/claude-haiku-4-5

# ── OpenAI ──────────────────────────────────────────────────────
# API key — daftar: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL (opsional) — ganti jika pakai proxy/OpenRouter/dll
# Default: https://api.openai.com
# OPENAI_BASE_URL=https://api.openai.com

# Model (opsional) — default: gpt-4o-mini
# OPENAI_MODEL=openai/gpt-4o-mini

# ── Server ──────────────────────────────────────────────────────
PORT=3000
